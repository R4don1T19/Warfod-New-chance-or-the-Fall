  Graph:
  - Speech: "\u042D\u0442\u043E\u043C\u0443 \u0436\u0438\u043B\u044C\u0446\u0443
      \u043F\u0440\u044F\u043C \u043D\u0435 \u0432\u0435\u0437\u0435\u0442. \u0412\u043E\u0442
      \u044D\u0442\u043E \u0440\u0430\u0437\u043B\u043E\u043C!"
  - Speech: "\u0417\u0430 \u0442\u0430\u043A\u043E\u0439 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u0441\u0440\u043E\u043A \u0442\u0430\u043A \u0441\u043B\u043E\u043C\u0430\u0442\u044C\u0441\u044F,
      \u044D\u0442\u043E \u043D\u0435\u043F\u043E\u0441\u0442\u0438\u0436\u0438\u043C\u043E!"
  - Speech: "\u041D\u043E \u0432\u0440\u043E\u0434\u0435 \u043A\u0430\u043A \u0443\u0436\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0436\u0438\u043B\u044C\u0446\u043E\u0432
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438 \u0434\u043E\u043C, \u0443\u0432\u0435\u0440\u0435\u043D,
      \u0437\u0430 \u044D\u0442\u0438\u043C \u043E\u043A\u043D\u043E\u043C \u0443\u0436\u0435
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0436\u0438\u0432\u0435\u0442."
