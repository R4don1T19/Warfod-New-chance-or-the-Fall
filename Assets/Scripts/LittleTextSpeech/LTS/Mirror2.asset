  Graph:
  - Speech: "\u0412\u0441\u0435-\u0442\u0430\u043A\u0438 \u043E\u043D\u043E \u0443\u043F\u0430\u043B\u043E."
  - Speech: "\u041F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u044D\u0442\u043E
      \u043F\u043E\u043A\u0430 \u043C\u0435\u043D\u044F \u043D\u0435 \u0431\u044B\u043B\u043E
      - \u0448\u0442\u044B\u0440\u044C \u043D\u0435 \u0441\u043C\u043E\u0433 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0438 \u0443\u043F\u0430\u043B
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0437\u0435\u0440\u043A\u0430\u043B\u043E\u043C."
  - Speech: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F \u044F \u043D\u0435 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
      \u0448\u0430\u043D\u0441\u043E\u043C, \u0443\u043F\u0443\u0441\u0442\u0438\u043B
      \u0435\u0433\u043E. \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0431\u0435\u0437 \u0437\u0435\u0440\u043A\u0430\u043B\u0430."
