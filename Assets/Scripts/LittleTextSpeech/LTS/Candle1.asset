  m_Script: {fileID: 11500000, guid: 4a05a7dcadf7c63409dc0ad68cc0eec9, type: 3}
  m_Name: Candle1
  m_EditorClassIdentifier: Assembly-CSharp::LittleTextSpeechGraph
  Graph:
  - Speech: "\u0412 \u0433\u0430\u0437\u0435\u0442\u0435 \u0443\u0437\u043D\u0430\u043B
      \u043F\u0440\u043E \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439
      \u0441\u043B\u0443\u0447\u0430\u0439, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043D\u043E\u0447\u044C\u044E \u0432 \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0435
      \u0431\u044B\u043B \u043D\u0430\u0439\u0434\u0435\u043D \u043C\u0435\u0440\u0442\u0432\u044B\u043C
      \u0436\u0438\u0442\u0435\u043B\u044C \u0434\u043E\u043C\u0430."
  - Speech: "\u0421\u043B\u0443\u0445\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043E\u043D \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435
      \u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u043F\u0430\u043B
      \u0438 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B \u0441\u0435\u0431\u0435
      \u0448\u0435\u044E \u043E \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435
      \u0441\u0442\u0443\u043F\u0435\u043D\u0438."
  - Speech: "\u0421 \u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
      \u044F \u0434\u0435\u0440\u0436\u0443 \u0441\u0432\u0435\u0447\u0443, \u043A\u0430\u043A
      \u0440\u0430\u0437 \u0443 \u043D\u0430\u0447\u0430\u043B\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0447\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u043B\u0435\u0442\u0430. \u041D\u0435 \u0434\u0430\u0439
      \u0431\u043E\u0433 \u0442\u0430\u043A\u043E\u043C\u0443 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0432 \u043C\u043E\u0435\u043C \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0435."
