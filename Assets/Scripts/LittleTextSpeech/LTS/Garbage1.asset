  Graph:
  - Speech: "\u041A\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
      \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u044C
      \u0442\u0430\u043A\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0432\u0435\u0434\u0440\u043E?"
  - Speech: "\u041C\u0443\u0441\u043E\u0440\u0430 \u0442\u0430\u043C \u043C\u043D\u043E\u0433\u043E,
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u043E \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u0442\u043E
      \u043F\u043E \u043F\u043E\u043B\u0443."
  - Speech: "\u041B\u044E\u0434\u0438 \u0442\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
      \u0432\u044B\u043C\u0435\u0449\u0430\u044E\u0442 \u0437\u043B\u043E\u0441\u0442\u044C
      \u0438 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E?
      \u041D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E."
