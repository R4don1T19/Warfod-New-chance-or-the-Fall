  Graph:
  - Speech: "\u042D\u0442\u043E \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u0441
      \u0440\u0430\u043D\u043D\u0438\u043C\u0438 \u043F\u043E\u0434\u0441\u043D\u0435\u0436\u043D\u0438\u043A\u0430\u043C\u0438."
  - Speech: "\u0415\u0451 \u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0435\u0449\u0435
      \u043E\u0447\u0435\u043D\u044C \u0434\u0430\u0432\u043D\u043E, \u043A\u043E\u0433\u0434\u0430
      \u0431\u044B\u043B \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u043E\u043C."
  - Speech: "\u041E\u0447\u0435\u043D\u044C \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F,
      \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u044D\u0442\u0438
      \u043F\u043E\u0434\u0441\u043D\u0435\u0436\u043D\u0438\u043A\u0438, \u043E\u043D\u0438
      \u043F\u0440\u044F\u043C \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u0432\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0439
      \u0433\u0440\u0443\u0434\u044C\u044E."
