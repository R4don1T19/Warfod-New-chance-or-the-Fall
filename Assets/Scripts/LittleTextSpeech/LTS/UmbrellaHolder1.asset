  Graph:
  - Speech: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u043A\u0442\u043E \u044D\u0442\u043E
      \u0441\u0434\u0435\u043B\u0430\u043B, \u043D\u043E \u043E\u043D \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043C\u043E\u043B\u043E\u0434\u0435\u0446."
  - Speech: "\u0421\u0443\u0434\u044F \u043F\u043E \u0437\u043E\u043D\u0442\u0443,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u044D\u0442\u043E \u0434\u0435\u043B\u043E
      \u0440\u0443\u043A \u0441\u0435\u043C\u044C\u0438 \u041A\u043E\u043B\u043B\u0438\u043D\u043E\u0432."
  - Speech: "\u041B\u043E\u0432\u043B\u044E \u0441\u0435\u0431\u044F \u043D\u0430
      \u043C\u044B\u0441\u043B\u0438, \u0447\u0442\u043E \u043C\u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E
      \u0441 \u0441\u043E\u0441\u0435\u0434\u044F\u043C\u0438. \u0421\u043F\u043B\u043E\u0448\u044C
      \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043B\u044E\u0434\u0438."
