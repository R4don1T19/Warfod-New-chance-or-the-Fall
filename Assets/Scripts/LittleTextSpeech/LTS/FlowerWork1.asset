  Graph:
  - Speech: "\u0422\u0430\u043A\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u0432\u0430\u0437\u0430, \u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u043F\u0430\u043F\u043E\u0440\u043E\u0442\u043D\u0438\u043A."
  - Speech: "\u041A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u0435\u0433\u043E
      \u043B\u0435\u0433\u043A\u043E \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u0432 \u043B\u0435\u0441\u0430\u0445, \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0431\u044B \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u0435?"
  - Speech: "\u0425\u043E\u0442\u044F, \u0435\u0441\u043B\u0438 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C...
      \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u044F \u043F\u0443\u0442\u0430\u044E?
      \u041A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437 \u0432\u044B\u0445\u043E\u0434\u0438\u043B \u0437\u0430
      \u043F\u0440\u0435\u0434\u0435\u043B\u044B \u0433\u043E\u0440\u043E\u0434\u0430?"
  - Speech: . . .
  - Speech: "\u041C\u0434\u0430 \u0443\u0436, \u043B\u0443\u0447\u0448\u0435 \u043E\u0431
      \u044D\u0442\u043E\u043C \u043D\u0435 \u0434\u0443\u043C\u0430\u0442\u044C..."
