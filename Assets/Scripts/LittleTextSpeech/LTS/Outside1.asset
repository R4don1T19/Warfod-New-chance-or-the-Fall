  Graph:
  - Speech: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u044F
      \u0443\u0436\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u044E \u043A
      \u0442\u0430\u043A\u043E\u043C\u0443."
  - Speech: "\u041F\u043E\u043C\u0438\u043C\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044E\u0449\u0438\u0445
      \u0441\u0442\u0435\u043D, \u043D\u0430\u0447\u0430\u043B\u0438 \u043C\u0435\u0440\u0446\u0430\u0442\u044C
      \u0438 \u0433\u0430\u0441\u043D\u0443\u0442\u044C \u0444\u043E\u043D\u0430\u0440\u0438. "
  - Speech: "\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435 \u043C\u043D\u0435
      \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0438\u0435
      \u043B\u0430\u043C\u044B \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0437\u0430\u043C\u0435\u043D\u044F\u0442\u044C \u0432 \u0442\u0430\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F. \u0417\u043D\u0430\u0447\u0438\u0442 \u0431\u0443\u0434\u0435\u043C
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430 \u0441\u0432\u0435\u0447\u0438."
