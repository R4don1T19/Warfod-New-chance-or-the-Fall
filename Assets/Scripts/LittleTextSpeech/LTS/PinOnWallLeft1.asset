  m_Script: {fileID: 11500000, guid: 4a05a7dcadf7c63409dc0ad68cc0eec9, type: 3}
  m_Name: PinOnWallLeft1
  m_EditorClassIdentifier: Assembly-CSharp::LittleTextSpeechGraph
  Graph:
  - Speech: "\u041E\u0434\u0438\u043D \u0441\u043B\u0443\u0447\u0430\u0439 \u044F
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0443 \u0441\u0435\u0431\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437-\u0437\u0430 \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u043E\u043D \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
      \u043C\u043E\u0438\u0445 \u0441\u043E\u0441\u0435\u0434\u0435\u0439 \u041A\u043E\u043B\u043B\u0438\u043D\u043E\u0432."
  - Speech: "\u0422\u0430\u043C \u0433\u0434\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043C\u0438\u0441\u0442\u0435\u0440 \u041A\u043E\u043B\u043B\u0438\u043D,
      \u0448\u0430\u0445\u0442\u0430 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435,
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u043B \u0437\u0430\u0432\u0430\u043B
      \u0448\u0430\u0445\u0442."
  - Speech: "\u0418\u0437 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E, \u0447\u0442\u043E \u0432\u0437\u0430\u043F\u0435\u0440\u0442\u0438
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0448\u0435\u0441\u0442\u044C
      \u0433\u0440\u0443\u043F\u043F \u0448\u0430\u0445\u0442\u0435\u0440\u043E\u0432,
      \u0432 \u043A\u0430\u043A\u043E\u0439 \u0438\u0437 \u043D\u0438\u0445 \u041A\u043E\u043B\u043B\u0438\u043D
      - \u043C\u043D\u0435 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E."
  - Speech: "\u0422\u043E\u043B\u044C\u043A\u043E \u0438 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F \u0438
      \u043D\u0430\u0434\u0435\u044F\u0442\u044C\u0441\u044F \u043D\u0430 \u043B\u0443\u0447\u0448\u0435\u0435."
