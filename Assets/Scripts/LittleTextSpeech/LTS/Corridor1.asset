  m_Name: Corridor1
  m_EditorClassIdentifier: Assembly-CSharp::LittleTextSpeechGraph
  Graph:
  - Speech: "\u0412\u0438\u0436\u0443, \u0447\u0442\u043E \u043D\u0430\u0448 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0441\u0442\u0430\u043B \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u043E\u0445\u043E\u0436\u0438\u043C
      \u043D\u0430 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0439 \u043D\u0430\u043C
      \u043F\u043E\u0434\u044A\u0435\u0437\u0434."
  - Speech: "\u041E\u0431\u0440\u044B\u0432\u043A\u0438 \u0431\u0443\u043C\u0430\u0433\u0438,
      \u043C\u0435\u0448\u043A\u0438 \u043C\u0443\u0441\u043E\u0440\u0430, \u043F\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u043D\u044B\u0435
      \u043E\u0431\u043E\u0438 \u0438 \u0434\u0430\u0436\u0435 \u0434\u0432\u0435\u0440\u0438
      \u043D\u0435 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
  - Speech: "\u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043F\u043B\u043E\u0445\u043E.
      \u0418 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0432\u0435\u0447\u0430
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442 \u0433\u043E\u0440\u0435\u0442\u044C."
