  m_Script: {fileID: 11500000, guid: 4a05a7dcadf7c63409dc0ad68cc0eec9, type: 3}
  m_Name: Corridor2
  m_EditorClassIdentifier: Assembly-CSharp::LittleTextSpeechGraph
  Graph:
  - Speech: "\u041D\u0430\u0448 \u043F\u043E\u0434\u044A\u0435\u0437\u0434 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0441\u044F
      \u0437\u0430\u0431\u0432\u0435\u043D\u0438\u044E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u044D\u0442\u043E \u043D\u0435 \u0443\u0431\u0435\u0436\u0438\u0449\u0435
      \u0434\u043B\u044F \u0436\u0438\u043B\u044C\u0446\u043E\u0432 \u0434\u043E\u043C\u0430."
  - Speech: "\u0414\u0430\u0436\u0435 \u0442\u0435, \u043A\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u044B
      \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u044D\u0442\u043E\u0442 \u0434\u043E\u043C - \u043E\u043D\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u044D\u0442\u0438\u043C."
  - Speech: "\u0423\u0432\u0435\u0440\u0435\u043D, \u0443 \u043D\u0438\u0445 \u0431\u044B\u043B
      \u0432\u044B\u0431\u043E\u0440 \u043C\u0435\u0436\u0434\u0443 \u0441\u0435\u043C\u044C\u0435\u0439
      \u0438 \u0434\u043E\u043B\u0433\u043E\u043C \u043F\u0435\u0440\u0435\u0434
      \u042F\u0438\u0440\u0438\u0441\u043E\u043C, \u0438 \u043E\u043D\u0438 \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440."
  - Speech: "\u0420\u0430\u0437 \u0443\u0436 \u044F \u0432\u0438\u0436\u0443, \u043A\u0430\u043A
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0433\u0430\u0441\u043D\u0435\u0442
      \u043C\u043E\u044F \u0436\u0438\u0437\u043D\u044C \u0432 \u044D\u0442\u043E\u0439
      \u0441\u0442\u0440\u0430\u043D\u0435."
