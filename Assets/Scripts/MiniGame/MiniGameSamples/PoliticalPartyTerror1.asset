  m_Name: PoliticalPartyTerror1
  m_EditorClassIdentifier: Assembly-CSharp::MinigameSample
  header: "\u0418\u0441\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435"
  text: "\u0422\u0440\u0438 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434 \u0431\u044B\u043B\u043E
    \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043E \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435
    \u043D\u0430 \u0448\u0442\u0430\u0431 \u043F\u0430\u0440\u0442\u0438\u0438 \u0446\u0435\u043D\u0442\u0440\u0438\u0441\u0442\u043E\u0432
    \"\u041F\u041E\u0421\u041B\u0415\u0414\u041D\u0418\u0419 \u0421\u0412\u0415\u0422\".
    \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u043F\u043E\u043A\u0443\u0448\u0435\u043D\u0438\u044F
    \u0431\u044B\u043B\u043E \u043D\u0430\u0439\u0434\u0435\u043D\u043E \u0443\u0431\u0438\u0442\u044B\u043C\u0438
    14 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0438\u0437 \u044D\u0442\u043E\u0439
    \u043F\u0430\u0440\u0442\u0438\u0438 \u0438 1 \u043D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0439.
    \u0412 \u0447\u0438\u0441\u043B\u0435 \u0443\u0431\u0438\u0442\u044B\u0445 \u0431\u044B\u043B\u0438
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0441\u0443\u043F\u0440\u0443\u0433\u0438-\u0433\u043B\u0430\u0432\u044B
    \u043F\u0430\u0440\u0442\u0438\u0438, \u0443 \u043D\u0438\u0445 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u0440\u0435\u0431\u0435\u043D\u043E\u043A, \u0441\u0443\u0434\u044C\u0431\u0430
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430
    \u043F\u043E \u0441\u0435\u0439 \u0434\u043D\u044C. \u0421\u0440\u0435\u0434\u0438
    \u0432\u0441\u0435\u0445 \u043F\u0430\u0440\u0442\u0438\u0439 \u0442\u043E\u043B\u044C\u043A\u043E
    \"\u0420\u0410\u0421\u0421\u0412\u0415\u0422\" \u0432\u044B\u0440\u0430\u0436\u0430\u044E\u0442
    \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u0435 \u043D\u0430\u0441\u0447\u0435\u0442
    \u0441\u043B\u0443\u0447\u0438\u0432\u0433\u0448\u0435\u0433\u043E\u0441\u044F.
    \u041D\u043E \u0440\u043E\u0432\u043D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043F\u0430\u0440\u0442\u0438\u044F \"\u0420\u0410\u0421\u041A\u041E\u041B\u042A\"
    \u0432\u0437\u044F\u043B\u0430 \u043E\u0442\u0432\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u0434\u0448\u0435\u0435,
    \u043D\u0430\u0437\u0432\u0430\u0432 \u044D\u0442\u043E \u043F\u0440\u0435\u0432\u0435\u043D\u0442\u0438\u0432\u043D\u044B\u043C
    \u0443\u0434\u0430\u0440\u043E\u043C. \u0412\u043B\u0430\u0441\u0442\u0438 \u0435\u0449\u0435
    \u043D\u0435 \u0434\u0430\u043B\u0438 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u043E\u0442\u0432\u0435\u0442, \u043D\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
    \u0447\u0442\u043E \u043F\u0440\u043E\u0442\u0438\u0432 \"\u0420\u0410\u0421\u041A\u041E\u041B\u042A\"
    \u0433\u043E\u0442\u043E\u0432\u044F\u0442\u0441\u044F \u0441\u0441\u0430\u043D\u043A\u0446\u0438\u0438."
  bottom: "\u041D\u0415 \u0414\u041B\u042F \u041F\u0415\u0427\u0410\u0422\u0418 \u0417\u0410
    \u041F\u0420\u0415\u0414\u0415\u041B\u0410\u041C\u0418 \u042F\u0418\u0420\u0418\u0421\u0410"
  LTS: {fileID: 11400000, guid: 507197fcd53aaf642ad18e4a6c6c6124, type: 2}
