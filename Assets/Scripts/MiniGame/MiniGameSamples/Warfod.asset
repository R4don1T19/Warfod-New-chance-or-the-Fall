  m_Script: {fileID: 11500000, guid: 44c4eb10de16a444a97625e90052e123, type: 3}
  m_Name: Warfod
  m_EditorClassIdentifier: Assembly-CSharp::MinigameSample
  header: "\u0412\u0430\u0440\u0444\u043E\u0434"
  text: "\u041D\u0430 \u0437\u0430\u043F\u0430\u0434\u0435 \u043A\u043E\u043D\u0442\u0438\u043D\u0435\u043D\u0442\u0430
    \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F \u043D\u043E\u0432\u043E\u0435
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E \u0412\u0430\u0440\u0444\u043E\u0434
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u043C\u0430\u043B\u043E\u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0433\u043E
    \u043F\u043E\u0440\u0442\u0430. \u0420\u0430\u0441\u0448\u0438\u0440\u044F\u044F\u0441\u044C,
    \u043E\u043D \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0432\u0430\u0436\u043D\u044B\u043C
    \u0443\u0437\u043B\u043E\u043C \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438
    \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438 \u0441 \u0411\u0430\u0439\u043B\u043E\u0440\u043E\u043C
    \u0438 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u043C\u0438 \u0441\u0442\u0440\u0430\u043D\u0430\u043C\u0438.
    \u0421\u0442\u0440\u0430\u043D\u044B, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0435\u0441\u044F
    \u043D\u0430 \u0433\u0440\u0430\u043D\u0438 \u0440\u0430\u0437\u0432\u0430\u043B\u0430,
    \u0443\u0436\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044E\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441
    \u043A \u0412\u0430\u0440\u0444\u043E\u0434\u0443, \u042F\u0438\u0440\u0438\u0441
    \u0432 \u0441\u0432\u043E\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0441\u0447\u0438\u0442\u0430\u0435\u0442,
    \u0447\u0442\u043E \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435
    \u0434\u0435\u0441\u044F\u0442\u044C \u043B\u0435\u0442 \u0412\u0430\u0440\u0444\u043E\u0434
    \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u0430\u043C\u044B\u043C \u0446\u0435\u043D\u043D\u044B\u043C
    \u0438\u0433\u0440\u043E\u043A\u043E\u043C \u0441\u0440\u0435\u0434\u0438 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
    \u0441\u0442\u0440\u0430\u043D."
