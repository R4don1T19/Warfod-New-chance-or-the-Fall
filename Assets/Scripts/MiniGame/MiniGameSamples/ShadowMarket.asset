  m_Name: ShadowMarket
  m_EditorClassIdentifier: Assembly-CSharp::MinigameSample
  header: "\u0422\u0435\u043D\u0435\u0432\u043E\u0439 \u0440\u044B\u043D\u043E\u043A"
  text: "\u0412\u043B\u0430\u0441\u0442\u0438 \u042F\u0438\u0440\u0438\u0441\u0430
    \u0432\u044B\u044F\u0432\u0438\u043B\u0438 \u0441\u043B\u0435\u0434 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438,
    \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0449\u0435\u0439\u0441\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435\u0439
    \u043B\u044E\u0434\u044C\u043C\u0438 \u0438 \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043D\u044B\u043C\u0438
    \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0430\u043C\u0438. \u041F\u043E
    \u0440\u0430\u0437\u043D\u044B\u043C \u0434\u0430\u043D\u043D\u044B\u043C, \u043A
    \u044D\u0442\u043E\u043C\u0443 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
    \u043F\u0440\u0438\u0447\u0430\u0441\u0442\u043D\u044B \u0440\u0430\u0434\u0438\u043A\u0430\u043B\u044B
    \u0438\u0437 \"\u0420\u0410\u0421\u041A\u041E\u041B\u042A\", \u043D\u043E \u0432
    \u0441\u0432\u043E\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u043E\u043D\u0438
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0435,
    \u043E\u0431\u0432\u0438\u043D\u044F\u044F \u0446\u0435\u043D\u0442\u0440\u0438\u0441\u0442\u043E\u0432
    \u0438\u0437 \"\u0420\u0410\u0421\u0421\u0412\u0415\u0422\". \u0420\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435
    \u043D\u043E\u0432\u043E\u0441\u0442\u043D\u044B\u0435 \u0441\u0432\u043E\u0434\u043A\u0438
    \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0442 \u043D\u0430\u043B\u0438\u0447\u0438\u0435
    \u0442\u0435\u043D\u0435\u0432\u043E\u0433\u043E \u0440\u044B\u043D\u043A\u0430
    \u0432 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u043A\u0430\u043A
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438."
  bottom: "\u041D\u0415 \u0414\u041B\u042F \u041F\u0415\u0427\u0410\u0422\u0418 \u0417\u0410
    \u041F\u0420\u0415\u0414\u0415\u041B\u0410\u041C\u0418 \u042F\u0418\u0420\u0418\u0421\u0410"
  LTS: {fileID: 11400000, guid: c28f5b9eedf8bdf4fa5db6b037229ee6, type: 2}
