  header: "\u041C\u0438\u0448\u0435\u043D\u044C"
  text: "\u0418\u0437 \u0441\u0435\u043C\u0438 \u0433\u0430\u0437\u0435\u0442 \u042F\u0438\u0440\u0438\u0441\u0430
    \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u0442\u0440\u0438. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0437\u0430\u043A\u0440\u044B\u0442\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430\u043C\u0438
    \u0438 \u0448\u0442\u0440\u0430\u0444\u0430\u043C\u0438. \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0441\u044F
    \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u044F\u043C \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043E
    \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u044B\u0432\u0430\u0442\u044C
    \u0432\u044B\u043F\u0443\u0441\u043A\u0438 \u0437\u0430\u0440\u0430\u043D\u0435\u0435."
  bottom: "\u0421\u0412\u0415\u0414\u0415\u041D\u0418\u042F \u0418\u0417 \u0412\u041D\u0423\u0422\u0420\u0415\u041D\u041D\u0418\u0425
