  header: "\u041C\u0438\u0448\u0435\u043D\u044C"
  text: "\u041D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u042F\u0438\u0440\u0438\u0441\u0430, \u043D\u0430 \u0441\u0430\u043C\u043E\u0439
    \u0433\u0440\u0430\u043D\u0438\u0446\u0435 \u0441 \u041F\u0443\u044D\u0440\u0442\u043E
    \u0436\u0435\u0441\u0442\u043E\u043A\u043E \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
    \u0438 \u043E\u0433\u0440\u0430\u0431\u0438\u043B\u0438 \u043D\u0435\u043E\u043F\u043E\u0437\u043D\u0430\u043D\u043D\u044B\u0439
    \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
    \u0412\u0441\u044F\u043A\u0438\u0435 \u043F\u043E\u043F\u044B\u0442\u043A\u0438
    \u043E\u043F\u043E\u0437\u043D\u0430\u0442\u044C \u043F\u0440\u0438\u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u044C
    \u043A \u043D\u0430\u0446\u0438\u0438 \u0443 \u0443\u0431\u0438\u0442\u044B\u0445
    \u043D\u0435 \u043F\u0440\u0438\u0432\u0435\u043B\u0438 \u043A \u043A\u0430\u043A\u0438\u043C-\u043B\u0438\u0431\u043E
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C. \u041F\u0430\u0440\u0442\u0438\u044F
    \"\u041F\u041E\u0421\u041B\u0415\u0414\u041D\u0418\u0419 \u0421\u0412\u0415\u0422\"
    \u0437\u0430\u044F\u0432\u043B\u044F\u0435\u0442 \u043E \u043F\u0440\u0438\u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438
    \u043A \u0421\u0435\u0432\u0435\u0440\u043D\u043E\u043C\u0443 \u0421\u043E\u044E\u0437\u0443
    \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442
    \u0432\u043B\u0430\u0441\u0442\u044C \u042F\u0438\u0440\u0438\u0441\u0430 \u043E
    \u0442\u043E\u043C, \u0447\u0442\u043E \u043F\u0440\u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u0438
    \u044D\u0442\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F, \u043D\u043E \u0438 \u043F\u043E\u0448\u0430\u0442\u043D\u0435\u0442
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043D\u0430\u0434 \u0441\u0432\u043E\u0435\u0439
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u042F\u0438\u0440\u0438\u0441\u0430."
  bottom: "\u041D\u0415 \u0414\u041B\u042F \u041F\u0415\u0427\u0410\u0422\u0418 \u0417\u0410
    \u041F\u0420\u0415\u0414\u0415\u041B\u0410\u041C\u0418 \u042F\u0418\u0420\u0418\u0421\u0410"
  LTS: {fileID: 0}
