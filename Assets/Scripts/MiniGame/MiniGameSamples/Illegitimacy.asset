  m_Name: Illegitimacy
  m_EditorClassIdentifier: Assembly-CSharp::MinigameSample
  header: "\u041F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0438\u044F"
  text: "\u0421\u0440\u043E\u043A \u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0438\u0439
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E \u0441\u043E\u0432\u0435\u0442\u0430
    \u042F\u0438\u0440\u0438\u0441\u0430 \u0438\u0441\u0442\u0451\u043A \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C
    \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u043D\u0430\u0437\u0430\u0434. \u041D\u043E\u0432\u044B\u0445
    \u0432\u044B\u0431\u043E\u0440\u043E\u0432 \u043D\u0435 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043E.
    \u0420\u0435\u0448\u0435\u043D\u0438\u044F \u0441\u043E\u0432\u0435\u0442\u0430
    \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043B\u044C,
    \u043D\u0435 \u0438\u043C\u0435\u044E\u0449\u0438\u0439 \u043C\u0430\u043D\u0434\u0430\u0442\u0430."
  bottom: "\u041E\u0424\u0418\u0426\u0418\u0410\u041B\u042C\u041D\u0410\u042F \u0421\u0412\u041E\u0414\u041A\u0410"
  LTS: {fileID: 11400000, guid: 5f75b7ac9262272418518b9f759c06cd, type: 2}
