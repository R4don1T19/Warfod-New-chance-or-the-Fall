  header: "\u041F\u0435\u0440\u0435\u0431\u043E\u0438 \u0441 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435\u043C"
  text: "\u0412 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0435
    \u0433\u043E\u0440\u043E\u0434\u043E\u0432 \u042F\u0438\u0440\u0438\u0441\u0430
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0431\u043E\u0438
    \u0441 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435\u043C. \u0423\u0432\u0435\u0440\u044F\u0435\u043C
    \u0432\u0430\u0441, \u0447\u0442\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u043D\u043E\u0441\u044F\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440, \u043F\u0440\u043E\u0441\u044C\u0431\u0430
    \u043D\u0435 \u043F\u0430\u043D\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u0438
    \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u043A\u043E\u0441\u0442\u0440\u044B \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0432\u0438\u0434\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E
    \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u044F."
  bottom: "\u041E\u0424\u0418\u0426\u0418\u0410\u041B\u042C\u041D\u0410\u042F \u0421\u0412\u041E\u0414\u041A\u0410"
  LTS: {fileID: 0}
