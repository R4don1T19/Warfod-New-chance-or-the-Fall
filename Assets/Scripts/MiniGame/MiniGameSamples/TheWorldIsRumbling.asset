  m_Script: {fileID: 11500000, guid: 44c4eb10de16a444a97625e90052e123, type: 3}
  m_Name: TheWorldIsRumbling
  m_EditorClassIdentifier: Assembly-CSharp::MinigameSample
  header: "\u041C\u0438\u0440"
  text: "\u0417\u0430\u043F\u0430\u0434\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u043A\u043E\u043D\u0442\u0438\u043D\u0435\u043D\u0442\u0430 \u0442\u0435\u0440\u043F\u0438\u0442
    \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0440\u0430\u0437\u043B\u0430\u0434
    \u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435. \u0427\u0438\u0441\u043B\u043E
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432, \u0431\u043B\u0438\u0437\u043A\u0438\u0445
    \u043A \u043A\u0440\u0430\u0445\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0438\u043B\u043E
    \u0437\u0430 \u043F\u044F\u0442\u044C. \u0412 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u0443 \u0421\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E \u0441\u043E\u044E\u0437\u0430
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
    - \u0411\u0440\u043E\u043C\u043D\u0438\u043D\u0433\u0441\u0442\u043E\u043D, \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
    \u0441 \u0431\u043E\u0433\u0430\u0442\u043E\u0439 \u0437\u0435\u043C\u043B\u0435\u0439,
    \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F
    \u043A \u0421\u0435\u0432\u0435\u0440\u043D\u043E\u043C\u0443 \u0441\u043E\u044E\u0437\u0443."
