  header: "\u041F\u043E\u0440\u0442 \u0441\u0440\u0435\u0434\u0438 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043D"
  text: "\u0412 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u043C \u043A\u043E\u043D\u0442\u0438\u043D\u0435\u043D\u0442\u0435
    \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u044B\u0439
    \u043F\u043E\u0440\u0442. \u0414\u0435\u0442\u0430\u043B\u0438 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B,
    \u043D\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442\u0441\u044F
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435
    \u043D\u043E\u0432\u044B\u0445, \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435
    \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0445 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
    \u043F\u0443\u0442\u0435\u0439 \u0431\u0435\u0434\u043D\u043E\u0439 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0441 \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u043C
    \u0441\u043E\u044E\u0437\u043E\u043C."
