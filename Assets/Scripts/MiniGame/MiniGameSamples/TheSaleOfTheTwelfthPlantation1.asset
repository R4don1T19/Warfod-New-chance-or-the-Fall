  m_Name: TheSaleOfTheTwelfthPlantation1
  m_EditorClassIdentifier: Assembly-CSharp::MinigameSample
  header: "\u0421\u0434\u0435\u043B\u043A\u0430"
  text: "\u0421\u043E\u0432\u0435\u0442 \u0433\u043E\u0440\u043E\u0434\u0430 \u0412\u0435\u043D\u0430\u0442
    \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u0437\u0435\u043C\u043B\u0438 \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0439
    \u043F\u043B\u0430\u043D\u0442\u0430\u0446\u0438\u0438 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0443 \u041F\u0443\u044D\u0440\u0442\u043E.
    \u0421\u0434\u0435\u043B\u043A\u0430 \u043D\u0430\u0437\u0432\u0430\u043D\u0430
    \u0432\u044B\u0433\u043E\u0434\u043D\u043E\u0439: \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u043D\u0430\u043F\u0440\u0430\u0432\u044F\u0442 \u043D\u0430 \u0440\u0435\u043C\u043E\u043D\u0442
    \u0434\u043E\u0440\u043E\u0433 \u0438 \u043F\u043B\u043E\u0442\u0438\u043D. \u0420\u0430\u0431\u043E\u0447\u0438\u0435
    \u043F\u043B\u0430\u043D\u0442\u0430\u0446\u0438\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442
    \u043C\u0435\u0441\u0442\u0430 \u043D\u0430 \u043F\u044F\u0442\u044C \u043B\u0435\u0442."
  bottom: "\u041E\u0424\u0418\u0426\u0418\u0410\u041B\u042C\u041D\u0410\u042F \u0421\u0412\u041E\u0414\u041A\u0410"
