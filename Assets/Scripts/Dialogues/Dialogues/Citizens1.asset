  Nodes:
  - Lines:
    - line: "\u0424\u0440\u043E\u043B\u0430\u043D \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442,
        \u0447\u0442\u043E \u0443 \u0441\u0442\u0435\u043D\u044B \u0436\u0438\u043B\u043E\u0433\u043E
        \u0434\u043E\u043C\u0430 \u0441\u0442\u043E\u044F\u0442 \u0434\u0432\u043E\u0435
        \u043C\u0443\u0436\u0447\u0438\u043D."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 0}
      FirstLine: 1
    - line: "\u041F\u043E\u0434\u043E\u0439\u0434\u044F \u0431\u043B\u0438\u0436\u0435,
        \u043E\u043D \u0443\u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E \u043D\u0430
        \u0441\u0442\u0435\u043D\u0435 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F
        \u0440\u0430\u0437\u043B\u043E\u043C."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
    - line: "\u041F\u043E\u0447\u0435\u043C\u0443 \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?
        \u0414\u043E\u043C \u0447\u0442\u043E, \u0440\u0443\u0445\u043D\u0435\u0442?"
      name: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0410"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
    - line: "\u0414\u0430 \u043D\u0435\u0442, \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
        - \u043D\u0435\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E \u043E\u0442\u0432\u0435\u0442\u0438\u043B
        \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446."
      name: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0411"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
    - line: "\u041D\u043E \u0432\u043E\u0442 \u0442\u043E \u0447\u0442\u043E \u0437\u0430
        \u043D\u043E\u0447\u044C \u0442\u0430\u043A\u0430\u044F \u0442\u0440\u0435\u0449\u0438\u043D\u0430
        \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C..."
      name: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0411"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
    - line: "\u041D\u0443\u0436\u043D\u043E \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
        \u043A \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044F\u043C - \u043D\u0435\u0440\u0432\u043D\u043E
        \u0441\u043A\u0430\u0437\u0430\u043B \u043C\u0443\u0436\u0447\u0438\u043D\u0430,
        \u043D\u0435\u043B\u044C\u0437\u044F \u044D\u0442\u043E \u0442\u0430\u043A
        \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C."
      name: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0410"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
    - line: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0434\u0430... "
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
    - line: "\u0424\u0440\u043E\u043B\u0430\u043D \u0442\u0443\u0442 \u0436\u0435
        \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B, \u0447\u0442\u043E \u044D\u0442\u043E
        \u0443\u0436\u0435 \u043D\u0435 \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439
        \u0441\u043B\u0443\u0447\u0430\u0439."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
