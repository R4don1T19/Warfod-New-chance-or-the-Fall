  Nodes:
  - Lines:
    - line: "\u0424\u0440\u043E\u043B\u0430\u043D \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
        \u0437\u043D\u0430\u043A\u043E\u043C\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u0443
        - \u0441\u0442\u0430\u0440\u0438\u043A\u0430 \u0413\u0435\u043E\u0440\u0433\u0438\u044F. "
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 1
    - line: "\u0420\u0435\u0448\u0430\u0435\u0442 \u043F\u043E\u0434\u043E\u0439\u0442\u0438
        \u043A \u043D\u0435\u043C\u0443."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 0
    - line: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439, \u0424\u0440\u043E\u043B\u0430\u043D,
        \u0435\u0441\u0442\u044C \u0433\u0430\u0437\u0435\u0442\u044B \u043D\u043E\u0432\u044B\u0435?"
      name: "\u0413\u0435\u043E\u0440\u0433\u0438\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8186455337503453142, guid: 1318c267db90fa447bd6cbf6ad62da8f, type: 3}
      FirstLine: 0
    - line: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043A\u0430\u043A \u0440\u0430\u0437
        \u0432\u044B\u0439\u0434\u0435\u0442 \u043D\u043E\u0432\u0430\u044F."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 0
    - line: "\u041F\u043E\u0441\u043B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
        \u0437\u0430\u0433\u043B\u044F\u043D\u0443 \u043A \u0432\u0430\u043C, \u0436\u0434\u0438\u0442\u0435
        \u0433\u0434\u0435-\u0442\u043E \u0432\u0435\u0447\u0435\u0440\u043E\u043C."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 0
    - line: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0431\u0443\u0434\u0443
        \u0436\u0434\u0430\u0442\u044C \u0442\u0435\u0431\u044F, \u043C\u0438\u043B\u043E\u043A"
      name: "\u0413\u0435\u043E\u0440\u0433\u0438\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8186455337503453142, guid: 1318c267db90fa447bd6cbf6ad62da8f, type: 3}
