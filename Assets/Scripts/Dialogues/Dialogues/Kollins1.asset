      OpponentSprite: {fileID: -3168641028027421460, guid: ff7b5745d4a275245b6cc67a89b832b9, type: 3}
      FirstLine: 0
    - line: "\u0412\u0441\u0435 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E,
        \u043D\u043E \u044D\u0442\u0430 \u043D\u0435\u0434\u0435\u043B\u044F \u043E\u0431\u0435\u0449\u0430\u0435\u0442
        \u0431\u044B\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: 371944261348726576, guid: 505a5fb69579fc547901b8ba05aabc71, type: 3}
      FirstLine: 0
    - line: "\u0412\u043E\u0442 \u0438 \u0441\u043B\u0430\u0432\u043D\u043E. \u0411\u0443\u0434\u0435\u043C
        \u043D\u0430\u0434\u0435\u044F\u0442\u044C\u0441\u044F \u043D\u0430 \u043B\u0443\u0447\u0448\u0435\u0435"
      name: "\u0410\u043D\u0430\u0442\u043E\u043B\u0438\u0439 \u041A\u043E\u043B\u043B\u0438\u043D"
