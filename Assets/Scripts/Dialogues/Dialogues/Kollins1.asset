      FirstLine: 1
    - line: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0424\u0440\u043E\u043B\u0430\u043D,
        \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u043D\u043E\u0432\u043E\u0441\u0442\u0438?"
      name: "\u0410\u043D\u0430\u0442\u043E\u043B\u0438\u0439 \u041A\u043E\u043B\u043B\u0438\u043D"
