  - Lines:
    - line: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
        \u0410\u043D\u0430\u0442\u043E\u043B\u0438\u0439 \u0438 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430
        \u041A\u043E\u043B\u043B\u0438\u043D\u044B."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
