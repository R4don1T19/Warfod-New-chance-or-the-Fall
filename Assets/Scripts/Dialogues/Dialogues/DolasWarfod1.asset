  - Lines:
    - line: "\u0424\u0440\u043E\u043B\u0430\u043D \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442,
        \u0447\u0442\u043E \u0443 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0439
        \u0441\u0442\u0435\u043D\u044B \u0441\u0442\u043E\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
        \u043E\u043D \u0440\u0435\u0448\u0430\u0435\u0442 \u043F\u043E\u0434\u043E\u0439\u0442\u0438
        \u043A \u043D\u0435\u043C\u0443."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 1
    - line: "\u041A\u0430\u0436\u0438\u0441\u044C \u0441\u043E \u0441\u0442\u0435\u043D\u043E\u0439
        \u0432\u0441\u0435 \u043D\u0435 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E,
        \u0434\u0430?"
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 0
    - line: . . .
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8505453282892827502, guid: a355ccc5c94a6e84cb33ad28d9b657ea, type: 3}
      FirstLine: 0
    - line: "\u042D\u0442\u0430 \u0441\u0442\u0435\u043D\u0430 \u043D\u0435\u0434\u0430\u0432\u043D\u043E
        \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430?"
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8505453282892827502, guid: a355ccc5c94a6e84cb33ad28d9b657ea, type: 3}
      FirstLine: 0
    - line: "\u0414\u0430, \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
        \u0443\u0442\u0440\u043E\u043C \u0435\u0451 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438
        \u0436\u0438\u043B\u044C\u0446\u044B \u0434\u043E\u043C\u0430 \u0438 \u044F,
        \u043F\u0440\u043E\u0445\u043E\u0434\u044F \u043C\u0438\u043C\u043E."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 0
    - line: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F,
        \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C
        \u0440\u0430\u0437\u043B\u043E\u043C \u0432 \u0441\u0442\u0435\u043D\u0435."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 0
  - Lines:
    - line: "\u0414\u0430? \u041D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E
        \u0442\u0443\u0442 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u0432\u0441\u0435 \u043F\u043B\u043E\u0445\u043E \u0443 \u0432\u0430\u0441
        \u2013 \u043E\u0442\u0432\u0435\u0442\u0438\u0432 \u0432\u043F\u043E\u043F\u0430\u0434,
        \u043E\u043D \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043D\u0430 \u0440\u0430\u0437\u043B\u043E\u043C \u0432 \u0441\u0442\u0435\u043D\u0435."
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8505453282892827502, guid: a355ccc5c94a6e84cb33ad28d9b657ea, type: 3}
      FirstLine: 1
    - line: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0432\u0441\u0435
        \u043C\u043E\u0433\u043B\u043E \u0431\u044B\u0442\u044C \u043B\u0443\u0447\u0448\u0435. "
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8505453282892827502, guid: a355ccc5c94a6e84cb33ad28d9b657ea, type: 3}
      FirstLine: 0
    - line: . . .
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 0
    - line: "\u0427\u0442\u043E \u0432\u044B \u0438\u043C\u0435\u043B\u0438 \u0432
        \u0432\u0438\u0434\u0443?"
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 0
    - line: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0438\u0437 \u0433\u0430\u0437\u0435\u0442\u043D\u043E\u0439
        \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u0438, \u0442\u044B \u043D\u0435
        \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0442\u0430\u043C
        \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0441 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0439
        \u043F\u043B\u0430\u043D\u0442\u0430\u0446\u0438\u0435\u0439?"
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8505453282892827502, guid: a355ccc5c94a6e84cb33ad28d9b657ea, type: 3}
      FirstLine: 0
    - line: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446, \u0431\u0443\u0434\u0442\u043E
        \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u0437\u0430\u0434\u0430\u043B
        \u043D\u0435 \u0442\u043E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441 \u0438
        \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
        \u0442\u0435\u043C\u0443."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 0
    - line: "\u041D\u043E \u0424\u0440\u043E\u043B\u0430\u043D \u0437\u0430\u043F\u043E\u0434\u043E\u0437\u0440\u0438\u043B
        \u0432 \u043D\u0435\u043C \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442\u0447\u0438\u043A\u0430."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -402642306464648069, guid: cc107949aef4c604a9b3902a19154e2e, type: 3}
      FirstLine: 0
    - line: "\u0412\u0441\u0435\u0433\u043E \u0434\u043E\u0431\u0440\u043E\u0433\u043E,
        \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0438\u0434\u0442\u0438
        \u2013  \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F \u0424\u0440\u043E\u043B\u0430\u043D."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
