  m_Name: WarfodEncounter2
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesGraph
  Nodes:
  - Lines:
    - line: "\u041F\u043E\u0434\u043E\u0448\u0435\u0434\u0448\u0438\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
        \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u0443\u044E
        \u043F\u0430\u0447\u043A\u0443 \u0431\u0443\u043C\u0430\u0433, \u043D\u0430
        \u043D\u0438\u0445 \u0447\u0442\u043E-\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E."
      name: 
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 3167889558151626326, guid: 770bc5a4d924f7243b6582e0d6c768ec, type: 3}
      FirstLine: 1
      IsSpecialFontUsed: 0
    - line: "\u0417\u0434\u0435\u0441\u044C \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
        \u043F\u043B\u0430\u043D\u044B \u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0443\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u043E
        \u0442\u043E, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u043E\u0441\u0432\u0435\u0449\u0430\u0442\u044C
        \u0432 \u0433\u0430\u0437\u0435\u0442\u0430\u0445."
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0411"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 6787925282690911049, guid: 00e353ebe4e12ef4b9a2d14fe8bedc38, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u043F\u0440\u043E\u0441\u0442\u0430,
        \u043E\u0441\u0432\u0435\u0449\u0430\u0439 \u0442\u043E\u043B\u044C\u043A\u043E
        \u043F\u0440\u0430\u0432\u0434\u0443. \u041D\u0443\u0436\u043D\u043E \u043E\u0441\u0432\u0435\u0449\u0430\u0442\u044C
        \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u044F"
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0411"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 6787925282690911049, guid: 00e353ebe4e12ef4b9a2d14fe8bedc38, type: 3}
      FirstLine: 1
      IsSpecialFontUsed: 0
    - line: "\u0424\u0440\u043E\u043B\u0430\u043D, \u0434\u0435\u0440\u0436\u0430
        \u0432 \u0440\u0443\u043A\u0435 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
        \u043E\u0431\u044A\u0435\u043C\u043D\u044B\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B,
        \u0442\u0443\u0442 \u0436\u0435 \u043F\u043E\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u0441\u044F,
        \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0441\u043B\u0435."
      name: 
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 3167889558151626326, guid: 770bc5a4d924f7243b6582e0d6c768ec, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0410 \u0447\u0442\u043E \u044F \u043F\u043E\u043B\u0443\u0447\u0443
        \u0432\u0437\u0430\u043C\u0435\u043D?"
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: 3167889558151626326, guid: 770bc5a4d924f7243b6582e0d6c768ec, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0412\u0441\u0435 \u0441\u043A\u043E\u0440\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F."
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0412"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -4366120871956825577, guid: 5d7b97619ce39d84db6f9ef2ef455025, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0420\u0430\u0437 \u0438 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0412"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -4366120871956825577, guid: 5d7b97619ce39d84db6f9ef2ef455025, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0418 \u0442\u044B \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C
        \u043D\u0430\u043C \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C."
      name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0412"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -4366120871956825577, guid: 5d7b97619ce39d84db6f9ef2ef455025, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u041F\u043E\u0441\u043B\u0435, \u044D\u0442\u0430 \u0442\u0440\u043E\u0438\u0446\u0430
        \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0435\u0433\u043E \u043E\u0434\u043D\u043E\u0433\u043E
        \u0441 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435\u043C."
      name: 
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -4366120871956825577, guid: 5d7b97619ce39d84db6f9ef2ef455025, type: 3}
