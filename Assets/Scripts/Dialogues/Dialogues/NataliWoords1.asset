  Nodes:
  - Lines:
    - line: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439, \u0424\u0440\u043E\u043B\u0430\u043D!"
      name: . . .
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 193408813720841868, guid: a7bda6e4214c8044481dc0192eedffb8, type: 3}
      FirstLine: 1
      IsSpecialFontUsed: 0
    - line: "\u0415\u0449\u0435 \u0442\u043E\u043B\u043A\u043E\u043C \u043D\u0435
        \u0437\u0430\u0439\u0434\u044F \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440,
        \u0424\u0440\u043E\u043B\u0430\u043D \u0443\u0432\u0438\u0434\u0435\u043B
        \u0437\u043D\u0430\u043A\u043E\u043C\u0443 \u0444\u0438\u0433\u0443\u0440\u0443
        \u0436\u0435\u043D\u0449\u0438\u043D\u044B."
      name: <.>
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 7808072162285160972, guid: 40fd049a86fa637449c54a32b86f4442, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439, \u041D\u0430\u0442\u0430\u043B\u0438,
        \u043A\u0430\u043A \u0442\u0432\u043E\u0439 \u0441\u044B\u043D?"
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: 7808072162285160972, guid: 40fd049a86fa637449c54a32b86f4442, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u041E\u043D \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435 \u043D\u0430
        \u043F\u043B\u0430\u043D\u0442\u0430\u0446\u0438\u0438, \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043B
        \u0432\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C,
        \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u0442\u043E\u0436\u0435
        \u0445\u043E\u0447\u0443 \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C!"
      name: "\u041D\u0430\u0442\u0430\u043B\u0438 \u0412\u0443\u0440\u0434\u0441"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 193408813720841868, guid: a7bda6e4214c8044481dc0192eedffb8, type: 3}
      FirstLine: 1
      IsSpecialFontUsed: 0
    - line: "\u0415\u0433\u043E \u0436\u0438\u0437\u043D\u044C \u043D\u0430\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F?
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E \u044D\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u0442\u044C."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: 7808072162285160972, guid: 40fd049a86fa637449c54a32b86f4442, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u042D\u0442\u043E\u0433\u043E \u043C\u043E\u0433\u043B\u043E \u043D\u0435
        \u0431\u044B\u0442\u044C, \u0435\u0441\u043B\u0438 \u0431\u044B \u043D\u0435
        \u0432\u0430\u0448\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430,
        \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u043C\u043E\u0433\u0443 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
        \u0432 \u0431\u043E\u043B\u0435\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439
        \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435."
      name: "\u041D\u0430\u0442\u0430\u043B\u0438 \u0412\u0443\u0434\u0441"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 193408813720841868, guid: a7bda6e4214c8044481dc0192eedffb8, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0415\u0449\u0435 \u0440\u0430\u0437, \u0441\u043F\u0430\u0441\u0438\u0431\u043E
        \u0432\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0435."
      name: "\u041D\u0430\u0442\u0430\u043B\u0438 \u0412\u0443\u0434\u0441"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 193408813720841868, guid: a7bda6e4214c8044481dc0192eedffb8, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0411\u0435\u0440\u0435\u0433\u0438\u0442\u0435 \u0441\u0435\u0431\u044F
        \u0438 \u0441\u0432\u043E\u0438\u0445 \u0431\u043B\u0438\u0437\u043A\u0438\u0445,
        \u041D\u0430\u0442\u0430\u043B\u0438."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: 7808072162285160972, guid: 40fd049a86fa637449c54a32b86f4442, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: . . .
      name: 
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 7808072162285160972, guid: 40fd049a86fa637449c54a32b86f4442, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0424\u0440\u043E\u043B\u0430\u043D \u0445\u043E\u0442\u0435\u043B
        \u0447\u0442\u043E-\u0442\u043E \u0435\u0439 \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
        \u043D\u043E \u0443\u0448\u0435\u043B, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
        \u0435\u0451 \u043E\u0434\u043D\u0443."
      name: '<.> '
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
