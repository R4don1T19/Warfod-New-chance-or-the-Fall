  m_Name: GeorgiyCorridor1
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesGraph
  Nodes:
  - Lines:
    - line: "\u0417\u0430\u0439\u0434\u044F \u0432 \u043F\u043E\u0434\u044A\u0435\u0437\u0434,
        \u0424\u0440\u043E\u043B\u0430\u043D \u0443\u0432\u0438\u0434\u0435\u043B
        \u043E\u0436\u0438\u0434\u0430\u044E\u0449\u0435\u0433\u043E \u0435\u0433\u043E
        \u0413\u0435\u043E\u0440\u0433\u0438\u044F."
      name: 
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 1
      IsSpecialFontUsed: 0
    - line: "\u041F\u043E\u043A\u0430 \u0442\u0435\u0431\u044F \u043D\u0435 \u0431\u044B\u043B\u043E,
        \u044F \u0442\u0443\u0442 \u043F\u0440\u0438\u0431\u0440\u0430\u043B\u0441\u044F,
        \u0441\u0442\u0430\u043B\u043E \u0447\u0438\u0449\u0435, \u0434\u0430?"
      name: "\u0413\u0435\u043E\u0440\u0433\u0438\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8186455337503453142, guid: 1318c267db90fa447bd6cbf6ad62da8f, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0412\u043E\u0442 \u0442\u0432\u043E\u044F \u0433\u0430\u0437\u0435\u0442\u0430,
        \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u043B\u0436\u0435\u043D
        \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C,
        \u0446\u0435\u043D\u0430 \u0432\u043D\u043E\u0432\u044C \u0432\u044B\u0440\u043E\u0441\u043B\u0430,
        \u0442\u0435\u043F\u0435\u0440\u044C \u0446\u0435\u043D\u0430 29 \u043C\u043E\u043D\u0435\u0442."
      name: "\u0424\u0440\u043E\u043B\u0430\u043D"
      FrolanSprite: {fileID: -846938088, guid: ecee09db27319e1488f211820f451b0d, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 1
      IsSpecialFontUsed: 0
    - line: "\u0413\u0435\u043E\u0440\u0433\u0438\u0439 \u043D\u0435 \u0441\u0434\u0435\u0440\u0436\u0430\u043B
        \u044D\u043C\u043E\u0446\u0438\u0438."
      name: 
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 1
      IsSpecialFontUsed: 0
    - line: "\u0414\u0430 \u043D\u0443 \u0442\u0435\u0431\u044F. \u041F\u043E\u0434\u043E\u0436\u0434\u0438
        \u043C\u0438\u043D\u0443\u0442\u0443, \u043F\u043E\u0438\u0449\u0443 \u0432
        \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u0445 \u0435\u0449\u0435 \u043C\u043E\u043D\u0435\u0442\u044B."
      name: "\u0413\u0435\u043E\u0440\u0433\u0438\u0439"
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: 8186455337503453142, guid: 1318c267db90fa447bd6cbf6ad62da8f, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u041F\u043E\u043A\u0430 \u0442\u043E\u0442 \u0448\u0430\u0440\u0438\u0442\u0441\u044F
        \u043F\u043E \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u043C, \u0424\u0440\u043E\u043B\u0430\u043D
        \u0441\u043B\u044B\u0448\u0438\u0442, \u043A\u0430\u043A \u043A\u0442\u043E-\u0442\u043E
        \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u043E\u0434\u044A\u0435\u0437\u0434."
      name: 
      FrolanSprite: {fileID: -5991791622712815195, guid: f2a1a9274b2d7bf4bb854c4d7a5c3766, type: 3}
      OpponentSprite: {fileID: -492930199441159793, guid: 9c476dd445de70e4e8a1100dee172642, type: 3}
      FirstLine: 0
      IsSpecialFontUsed: 0
