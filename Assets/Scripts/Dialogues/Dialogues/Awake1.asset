  Nodes:
  - Lines:
    - line: "\u2014 \u0412\u0442\u043E\u0440\u043E\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B
        4-\u043E\u0433\u043E \u0433\u043E\u0434\u0430 \u0441 \u043C\u043E\u043C\u0435\u043D\u0442\u0430
        \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0412\u0430\u0440\u0444\u043E\u0434\u0430."
      name: <.>
      FrolanSprite: {fileID: 0}
      OpponentSprite: {fileID: 0}
      FirstLine: 1
      IsSpecialFontUsed: 1
    - line: "\u0416\u0438\u0437\u043D\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0432\u0441\u0435 \u0442\u044F\u0436\u0435\u043B\u0435\u0435 \u0432 \u042F\u0438\u0440\u0438\u0441\u0435."
      name: <..>
      FrolanSprite: {fileID: 0}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u0411\u0443\u0434\u0443\u0447\u0438 \u0433\u0430\u0437\u0435\u0442\u0447\u0438\u043A\u043E\u043C,
        \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u043E\u043C
        \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0435\u043B\u0430 \u043E\u043D
        \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E, 
        \u0447\u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C
        \u043E\u0431\u044B\u0447\u043D\u043E\u043C\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443,
        \u0436\u0438\u0432\u0443\u0449\u0435\u0433\u043E \u0440\u0430\u0434\u0438
        \u0441\u0430\u043C\u043E\u0433\u043E \u0441\u0435\u0431\u044F."
      name: <.>
      FrolanSprite: {fileID: 0}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u041D\u043E \u043F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0435
        \u043E\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044F \u0438\u043C\u0435\u043D\u043D\u043E
        \u0442\u0430\u043A?"
      name: <..>
      FrolanSprite: {fileID: 0}
      OpponentSprite: {fileID: 0}
      FirstLine: 0
      IsSpecialFontUsed: 0
    - line: "\u2013 \u0437\u0430\u0434\u0430\u0435\u0442\u0441\u044F \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C
        \u0424\u0440\u043E\u043B\u0430\u043D. "
      name: <..>
